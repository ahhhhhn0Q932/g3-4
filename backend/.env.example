# ClassPanel 后端开发环境配置（复制为 .env 后修改）
NODE_ENV=development
PORT=3001

# MySQL Community（本机开发实例，脚本 mysql:setup 默认监听 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=classpanel
DB_PASSWORD=classpanel_dev_pwd
DB_NAME=classpanel

# 登录会话签名密钥，务必改成长随机字符串
JWT_SECRET=dev-only-change-this-to-a-long-random-string

# 允许访问 API 的前端地址（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 前端静态服务端口（backend/scripts/static-server.js）
FRONTEND_PORT=5173
